PORT=4000
NODE_ENV=development
# Neon pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Neon direct connection string for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
ADMIN_EMAIL="admin@fundastra.in"
ADMIN_PASSWORD="ChangeThisStrongPassword123!"
CORS_ORIGINS="http://localhost:3001,http://localhost:3000"

# Public origin used to build uploaded image URLs
PUBLIC_API_ORIGIN="http://localhost:4000"
